#!/bin/sh
# 推送前自检：编译、测试、泄露检查、.bat 编码、文档图片、占位符、数据目录
# 启用：git config core.hooksPath .githooks
# 跳过：git push --no-verify
set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

run_preflight() {
    for py in ".venv/Scripts/python.exe" ".venv/bin/python" "python3" "python"; do
        if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys" >/dev/null 2>&1; then
            "$py" scripts/preflight.py
            return $?
        fi
    done
    return 127
}

run_preflight
code=$?
if [ "$code" -eq 127 ]; then
    echo "preflight: 没有可用的 Python，已跳过自检" >&2
    exit 0
fi
exit "$code"
